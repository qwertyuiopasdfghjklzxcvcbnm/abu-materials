      "english_subtitle_excerpts": [
        {
          "cue_id": 388,
          "en": "To me, I don’t like indicators because I get stressed out constantly looking..."
        },
        {
          "cue_id": 412,
          "en": "So indicators, it’s an excuse to avoid thinking about the obvious."
        },
        {
          "cue_id": 418,
          "en": "However, what is the probability? The probability is extremely low."
        },
